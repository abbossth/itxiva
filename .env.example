# MongoDB Atlas ulanish manzili (masalan: mongodb+srv://username:password@cluster.mongodb.net/itxiva)
MONGODB_URI=

# JWT tokenlarini imzolash uchun maxfiy kalit (kamida 32 ta belgi)
JWT_SECRET=

# Cloudflare R2 kalitlari (S3 API mos)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# Ilova manzili
NEXT_PUBLIC_APP_URL=

# Claude API kaliti (dars yaratishdagi AI yordamchi uchun)
ANTHROPIC_API_KEY=
# Asosiy AI (bepul tarif) — aistudio.google.com. ANTHROPIC_API_KEY ixtiyoriy zaxira
GEMINI_API_KEY=

# Telegram bildirishnomalari (@BotFather'dan olinadi). Bo'sh qoldirilsa, Telegram bo'limi o'chiq bo'ladi.
TELEGRAM_BOT_TOKEN=
# Bot username'i, @ belgisisiz (masalan: it_xiva_bot)
TELEGRAM_BOT_USERNAME=
# Webhook'ni himoyalaydigan tasodifiy satr: openssl rand -hex 24
# (scripts/telegram-webhook.mjs bilan o'rnatilganda Vercel'dagi qiymat bilan bir xil bo'lishi shart)
TELEGRAM_WEBHOOK_SECRET=
# Kunlik eslatmalar (/api/cron/daily) uchun: openssl rand -hex 24. Vercel Cron shu qiymatni o'zi yuboradi.
CRON_SECRET=
