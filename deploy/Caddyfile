# VPS'da: /etc/caddy/Caddyfile. Sertifikatni Caddy o'zi oladi va yangilaydi (Let's Encrypt, 80-port).
# Sayt oldida Cloudflare turadi: haqiqiy o'quvchi IP'si CF-Connecting-IP sarlavhasida keladi.
# Cloudflare manzillari: https://www.cloudflare.com/ips/ (o'zgarsa, shu ro'yxat va ufw yangilanadi)
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

itxiva.uz {
	redir https://www.itxiva.uz{uri} 308
}

www.itxiva.uz {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		# Ilova login cheklovi x-forwarded-for'ning birinchi qiymatini o'qiydi — u doim haqiqiy mijoz IP'si bo'lsin
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		# Yangi versiya ishga tushayotgan bir necha soniyada so'rovlar xato bermay kutadi
		lb_try_duration 20s
		lb_try_interval 250ms
	}
	log {
		output file /var/log/caddy/itxiva.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
